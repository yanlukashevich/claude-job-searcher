# Python
__pycache__/
*.pyc
.venv/

# Backups (scripts write .bak next to their output)
*.bak

# Generated review page (finder/prototype/browse.py regenerates it)
finder/prototype/offers.html

# Run output — personal application data, written by the Cowork applier every run.
# Local-only: the audit trail and the current queue are state, not source.
src/applications_log.jsonl
src/todo_manual.md
src/worklist.json

# CV PDFs — personal documents, not source. The applier reads them from disk, so the
# folder stays (with its per-variant subfolders); the files themselves never get committed.
src/CV_PDF/*
!src/CV_PDF/.gitkeep

# Finder state — the harvested offer db, your manual marks and score overrides, the
# harvest run history. All of it is regenerated by harvest.py / the cockpit; none of it
# is source. (finder/data/ itself stays, so the scripts have somewhere to write.)
finder/data/*
!finder/data/.gitkeep

# The pracuj.pl census — ~55 MB of scraped listing, regenerated by one command.
scan_pracuj/data/
